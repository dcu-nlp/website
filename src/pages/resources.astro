---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { getSiteHref } from '@/utils/urls';
import { getEntrySlug } from '@/utils/content';
const resources = await getCollection('resources');
const projects = await getCollection('projects');
const publications = await getCollection('publications');
for (const resource of resources) {
  for (const id of resource.data.projects)
    if (!projects.some((entry) => getEntrySlug(entry) === id))
      throw new Error(`Unknown resource project: ${id}`);
  for (const id of resource.data.publications)
    if (!publications.some((entry) => getEntrySlug(entry) === id))
      throw new Error(`Unknown resource publication: ${id}`);
}
---

<Layout
  title="Code and datasets"
  description="Research code, datasets, documentation, and access instructions from the group."
>
  <PageHero
    eyebrow="Resources"
    title="Code and datasets"
    description="Explore the materials behind our research, with documentation, access information, and associated papers."
  />
  <section class="section-space">
    <div class="container-shell grid gap-6 md:grid-cols-2">
      {
        resources.map(({ data: resource, id }) => (
          <article id={id} class="card-surface p-6 sm:p-8">
            <p class="eyebrow">{resource.kind.replaceAll('-', ' ')}</p>
            <h2 class="mt-4 text-3xl text-ink-900">{resource.title}</h2>
            <p class="mt-4 text-ink-600">{resource.summary}</p>
            <dl class="mt-6 space-y-4 text-sm leading-7 text-ink-600">
              <div>
                <>
                  <dt class="font-semibold text-ink-900">Access and setup</dt>
                  <dd>{resource.access}</dd>
                </>
              </div>
              <div>
                <>
                  <dt class="font-semibold text-ink-900">Licence</dt>
                  <dd>{resource.license}</dd>
                </>
              </div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-4">
              {resource.repositoryUrl && (
                <a class="text-link" href={resource.repositoryUrl}>
                  Code repository
                </a>
              )}
              {resource.dataUrl && (
                <a class="text-link" href={resource.dataUrl}>
                  Dataset files and availability
                </a>
              )}
              <a class="text-link" href={resource.documentationUrl}>
                Documentation
              </a>
            </div>
            <h3 class="mt-6 font-semibold text-ink-900">Related research</h3>
            <ul class="mt-3 space-y-2">
              {projects
                .filter((entry) =>
                  resource.projects.includes(getEntrySlug(entry)),
                )
                .map((entry) => (
                  <li>
                    <a
                      class="text-link"
                      href={getSiteHref(`/projects/${getEntrySlug(entry)}/`)}
                    >
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              {publications
                .filter((entry) =>
                  resource.publications.includes(getEntrySlug(entry)),
                )
                .map((entry) => (
                  <li>
                    <a
                      class="text-link"
                      href={getSiteHref(
                        `/publications/${getEntrySlug(entry)}/`,
                      )}
                    >
                      {entry.data.title}
                    </a>
                  </li>
                ))}
            </ul>
            <p class="mt-5 text-xs text-ink-500">
              Access information reviewed{' '}
              {resource.reviewedAt.toISOString().slice(0, 10)}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
