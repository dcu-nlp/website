---
import { getCollection } from 'astro:content';
import CampusGallery from '@/components/CampusGallery.astro';
import NewsCard from '@/components/NewsCard.astro';
import Card from '@/components/Card.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import PersonCard from '@/components/PersonCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Layout from '@/layouts/Layout.astro';
import { pickEntriesBySlug } from '@/utils/content';
import {
  getFeaturedPublications,
  mergePublications,
} from '@/utils/publications';
import { siteConfig } from '@/utils/site';
import { getMailtoHref, getSiteHref } from '@/utils/urls';

const [people, projects, publicationEntries, news] = await Promise.all([
  getCollection('people'),
  getCollection('projects'),
  getCollection('publications'),
  getCollection('news'),
]);

const latestNews = news
  .filter((item) => item.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const featuredThemes = siteConfig.homeFeatured.researchThemes
  .map((id) => siteConfig.researchThemes.find((theme) => theme.id === id))
  .filter(
    (theme): theme is (typeof siteConfig.researchThemes)[number] =>
      theme !== undefined,
  );

const featuredPeople = pickEntriesBySlug(
  people,
  siteConfig.homeFeatured.people,
);
const featuredProjects = pickEntriesBySlug(
  projects,
  siteConfig.homeFeatured.projects,
);

const featuredPublications = getFeaturedPublications(
  mergePublications(publicationEntries),
  5,
);
---

<Layout title="Home" description={siteConfig.description}>
  <section
    id="overview"
    class="section-anchor pt-6 pb-10 sm:pt-8 sm:pb-12 lg:pt-10 lg:pb-14"
  >
    <div class="container-shell">
      <CampusGallery>
        <div class="hero-overlay-copy">
          <div class="hero-overlay-heading">
            <p class="section-kicker">
              {siteConfig.homeSections.overview.eyebrow}
            </p>
            <h1 class="hero-overlay-title">
              {
                siteConfig.homeSections.overview.titleLines.map((line) => (
                  <span class="hero-overlay-title-line">{line}</span>
                ))
              }
            </h1>
          </div>
          <p class="hero-overlay-description">
            {siteConfig.homeSections.overview.description}
          </p>
          <div class="hero-overlay-actions">
            <a
              class="button-primary"
              href={getSiteHref(siteConfig.homeSections.overview.primaryHref)}
            >
              {siteConfig.homeSections.overview.primaryLabel}
            </a>
            <a
              class="button-secondary border-white/20 bg-white/10 text-white hover:border-white/40 hover:text-white"
              href={getSiteHref(siteConfig.homeSections.overview.secondaryHref)}
            >
              {siteConfig.homeSections.overview.secondaryLabel}
            </a>
          </div>
          <div class="hero-metric-grid max-w-3xl">
            <div class="hero-metric">
              <p class="hero-metric__value">NLP</p>
              <p class="hero-metric__label">Research-led methods</p>
            </div>
            <div class="hero-metric">
              <p class="hero-metric__value">DCU</p>
              <p class="hero-metric__label">Academic home and network</p>
            </div>
            <div class="hero-metric">
              <p class="hero-metric__value">Partners</p>
              <p class="hero-metric__label">Open to applied collaboration</p>
            </div>
          </div>
        </div>
      </CampusGallery>
    </div>
  </section>

  {
    latestNews.length > 0 && (
      <section
        id="news"
        class="section-anchor section-space pt-0"
        aria-label="Latest news"
      >
        <div class="container-shell">
          <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
            <div>
              <>
                <p class="eyebrow">From the group</p>
                <h2 class="mt-3 text-4xl text-ink-900 sm:text-5xl">
                  Latest news
                </h2>
              </>
            </div>
            <a class="text-link" href={getSiteHref('/news/')}>
              All news <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-3">
            {latestNews.map((item) => (
              <NewsCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section-space pt-0">
    <div class="container-shell">
      <div class="showcase-panel">
        <div class="max-w-3xl">
          <p class="eyebrow">Research Profile</p>
          <h2 class="mt-4 text-4xl text-ink-900 sm:text-5xl">
            Research that connects language technology, evaluation, and
            real-world use
          </h2>
          <p class="mt-5 text-base leading-8 text-ink-600">
            At Dublin City University, the group works across NLP, multilingual
            systems, and responsible AI with a focus on methods that are
            technically strong, carefully evaluated, and useful beyond the lab.
          </p>
        </div>
        <div class="showcase-list mt-8">
          <article class="showcase-item">
            <p class="showcase-item__label">Research</p>
            <h3 class="showcase-item__title">
              Method-driven language technology
            </h3>
            <p class="showcase-item__body">
              The research combines core language technology with evaluation,
              interpretability, and trustworthy system design so that technical
              advances remain rigorous and explainable.
            </p>
          </article>
          <article class="showcase-item">
            <p class="showcase-item__label">Impact</p>
            <h3 class="showcase-item__title">
              Built for meaningful application
            </h3>
            <p class="showcase-item__body">
              Projects span multilingual access, data-to-text generation, and
              responsible AI questions shaped by practical settings in
              education, public engagement, and applied research.
            </p>
          </article>
          <article class="showcase-item">
            <p class="showcase-item__label">Collaboration</p>
            <h3 class="showcase-item__title">
              Open to interdisciplinary partnerships
            </h3>
            <p class="showcase-item__body">
              The group is positioned for collaboration with researchers,
              students, and external partners who want serious academic work
              linked to real constraints, shared goals, and long-term value.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="research" class="section-anchor section-space pt-2">
    <div class="container-shell page-grid">
      <div class="section-surface">
        <SectionHeader
          eyebrow="Research"
          title="Research themes and selected projects"
          description="An overview of the group’s core themes, applied projects, and current research direction."
        />
        <div class="grid gap-6 lg:grid-cols-3">
          {
            featuredThemes.map((theme) => (
              <Card
                title={theme.title}
                description={theme.description}
                meta="Theme"
              />
            ))
          }
        </div>
        <div class="mt-8 grid gap-6 xl:grid-cols-3">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </div>
  </section>

  <section id="publications" class="section-anchor section-space">
    <div class="container-shell page-grid">
      <div class="section-surface">
        <SectionHeader
          eyebrow="Publications"
          title="Recent publications from the group"
          description="Recent outputs from across the group, with curated detail pages where available."
        />
        <div class="grid gap-6 xl:grid-cols-3">
          {
            featuredPublications.map((publication) => (
              <PublicationCard publication={publication} />
            ))
          }
        </div>
        <div class="mt-8">
          <a class="button-secondary" href={getSiteHref('/publications/')}>
            Browse the full publications archive
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="people" class="section-anchor section-space">
    <div class="container-shell page-grid">
      <div class="section-surface">
        <SectionHeader
          eyebrow="People"
          title="People across research, teaching, and applied collaboration"
          description="Meet the researchers, fellows, doctoral students, and collaborators contributing to the group’s work."
        />
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {featuredPeople.map((person) => <PersonCard person={person} />)}
        </div>
      </div>
    </div>
  </section>

  <LogoStrip />

  <section id="contact" class="section-anchor section-space pt-0">
    <div class="container-shell">
      <div
        class="section-band-dark contact-banner grid gap-8 lg:grid-cols-[1.1fr_0.9fr]"
      >
        <div>
          <p class="section-kicker">Contact</p>
          <h2 class="mt-4 text-4xl text-white sm:text-5xl">
            Start a research, project, or partnership conversation
          </h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-ink-200">
            If the group’s work aligns with your interests, a concise message
            with your context, research interest, or collaboration idea is the
            best place to begin.
          </p>
        </div>
        <div class="surface p-8">
          <dl class="space-y-5 text-sm leading-7 text-ink-600">
            <div>
              <dt class="font-semibold text-ink-900">Email</dt>
              <dd>
                <a
                  class="text-link"
                  href={getMailtoHref(siteConfig.contact.email)}
                  >{siteConfig.contact.email}</a
                >
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Institution</dt>
              <dd>{siteConfig.contact.institution}</dd>
            </div>
            <div>
              <dt class="font-semibold text-ink-900">Location</dt>
              <dd>{siteConfig.contact.location}</dd>
            </div>
          </dl>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a class="button-primary" href={getSiteHref('/contact/')}>
              View contact page
            </a>
            <a class="button-secondary" href={getSiteHref('/research/')}>
              Explore research
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
