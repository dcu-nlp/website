---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { siteConfig } from '@/utils/site';
import { getMailtoHref } from '@/utils/urls';
---

<Layout
  title="Contact"
  description="Contact details for Dr Brian Davis and the NLP Applications Group at Dublin City University."
>
  <PageHero
    eyebrow="Contact"
    title="Start a research or partnership conversation"
    description="If the group's work aligns with your interests, a short and specific email is the best way to get in touch."
  />

  <section class="section-space">
    <div class="container-shell grid gap-6 xl:grid-cols-[0.95fr_1.05fr]">
      <article class="surface p-5 sm:p-8 lg:p-10">
        <p class="eyebrow">Direct contact</p>
        <h2
          class="mt-4 text-[clamp(2rem,7vw,2.7rem)] leading-[1.04] text-ink-900"
        >
          Brian Davis and the NLP Applications Group
        </h2>
        <dl class="mt-8 space-y-5 text-sm leading-7 text-ink-600">
          <div>
            <dt class="font-semibold text-ink-900">Email</dt>
            <dd>
              <a
                class="text-link"
                href={getMailtoHref(siteConfig.contact.email)}
                >{siteConfig.contact.email}</a
              >
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Institution</dt>
            <dd>{siteConfig.contact.institution}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Location</dt>
            <dd>{siteConfig.contact.location}</dd>
          </div>
        </dl>
      </article>

      <article class="surface relative overflow-hidden p-5 sm:p-8 lg:p-10">
        <div
          class="absolute -right-10 top-8 hidden h-28 w-28 rounded-full border border-accent-400/20 bg-accent-400/10 sm:block"
        >
        </div>
        <div
          class="absolute bottom-6 right-16 hidden h-16 w-16 rounded-2xl border border-ink-200/80 bg-white/60 sm:block"
        >
        </div>
        <p class="eyebrow">What to include</p>
        <h2
          class="mt-4 text-[clamp(2rem,7vw,2.7rem)] leading-[1.04] text-ink-900"
        >
          A concise first email works best
        </h2>
        <ul class="mt-8 space-y-4 text-sm leading-7 text-ink-600">
          <li>Your role, institution, or current stage of study</li>
          <li>The research area or collaboration idea you want to discuss</li>
          <li>Relevant papers, project links, or work samples</li>
          <li>Any timing, funding, or application context that matters</li>
        </ul>
        <p class="mt-8 text-sm leading-7 text-ink-500">
          A clear first message makes it easier to understand the fit quickly
          and respond in a useful way.
        </p>
      </article>
    </div>
  </section>
</Layout>
