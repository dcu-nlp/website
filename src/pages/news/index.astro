---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import NewsCard from '@/components/NewsCard.astro';
import PageHero from '@/components/PageHero.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout
  title="News"
  description="Recent updates, milestones, publications, and events from the group."
>
  <PageHero
    eyebrow="News"
    title="What the group has been working on"
    description="A running record of publications, invited talks, teaching activity, funding, and community milestones."
  />
  <section class="section-space">
    <div class="container-shell grid gap-6 lg:grid-cols-2">
      {news.map((item) => <NewsCard item={item} />)}
    </div>
  </section>
</Layout>
