---
import { getCollection, render } from 'astro:content';
import PublicationCard from '@/components/PublicationCard.astro';
import PersonCard from '@/components/PersonCard.astro';
import { mergePublications } from '@/utils/publications';
import { isMember, isProjectPublication } from '@/utils/relationships';
import Layout from '@/layouts/Layout.astro';
import { getSiteHref } from '@/utils/urls';
import { getEntrySlug } from '@/utils/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: getEntrySlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const resources = (await getCollection('resources')).filter((entry) =>
  entry.data.projects.includes(getEntrySlug(project)),
);
const members = (await getCollection('people')).filter((person) =>
  isMember(person, project),
);
const papers = mergePublications(await getCollection('publications')).filter(
  (paper) => isProjectPublication(project, paper),
);
---

<Layout title={project.data.title} description={project.data.summary}>
  <section class="section-space">
    <div class="container-shell">
      <div class="surface px-5 py-8 sm:px-8 sm:py-10 lg:px-12">
        <p class="eyebrow">{project.data.status}</p>
        <h1 class="detail-page-title mt-4 max-w-4xl text-ink-900">
          {project.data.title}
        </h1>
        <p
          class="mt-5 max-w-3xl text-base leading-7 text-ink-600 sm:mt-6 sm:text-lg sm:leading-8"
        >
          {project.data.summary}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            project.data.tags.map((tag: string) => (
              <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
                {tag}
              </span>
            ))
          }
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          {
            project.data.links.map((link: { label: string; href: string }) => (
              <a class="text-sm font-semibold text-accent-600" href={link.href}>
                {link.label}
              </a>
            ))
          }
        </div>
        <article class="prose-panel mt-10">
          <Content />
        </article>
        {
          resources.length > 0 && (
            <section class="mt-10">
              <>
                <h2 class="text-3xl text-ink-900">Code and datasets</h2>
                <ul class="mt-4 space-y-3">
                  {resources.map((resource) => (
                    <li>
                      <a
                        class="text-link"
                        href={getSiteHref(`/resources/#${resource.id}`)}
                      >
                        {resource.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            </section>
          )
        }
        <section class="mt-10" aria-label="Project researchers">
          <h2 class="text-3xl text-ink-900">Researchers</h2>
          <div class="mt-5 grid gap-6 md:grid-cols-2">
            {members.map((person) => <PersonCard person={person} />)}
          </div>
        </section>
        {
          papers.length > 0 && (
            <section class="mt-10">
              <>
                <h2 class="text-3xl text-ink-900">Related publications</h2>
                <div class="mt-5 grid gap-6 md:grid-cols-2">
                  {papers.map((publication) => (
                    <PublicationCard publication={publication} />
                  ))}
                </div>
              </>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Layout>
