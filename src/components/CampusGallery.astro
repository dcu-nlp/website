---
import { getAssetHref } from '@/utils/urls';
---

<section class="campus-gallery" aria-label="Dublin City University campus">
  <div
    class="campus-gallery__viewport"
    data-hero-parallax
    data-hero-parallax-active="false"
  >
    <figure class="campus-gallery__slide is-active">
      <div class="campus-gallery__image-motion">
        <img
          src={getAssetHref('/images/campus/woodlock-hall-library-table.jpg')}
          alt="Reading table inside Woodlock Hall library at Dublin City University."
          class="campus-gallery__image"
          loading="eager"
          decoding="async"
        />
      </div>
    </figure>
    <div class="campus-gallery__overlay">
      <slot />
    </div>
  </div>
</section>
