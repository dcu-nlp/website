---
interface Props {
  title: string;
  mission: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  imageSrc: string;
  imageAlt: string;
}

const {
  title,
  mission,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="section-space">
  <div class="container-shell">
    <div
      class="surface hero-panel relative overflow-hidden px-5 py-8 sm:px-10 sm:py-12 lg:px-14 lg:py-16"
    >
      <div
        class="absolute -left-12 top-10 hidden h-32 w-32 rounded-full border border-accent-400/20 bg-accent-400/8 blur-[1px] sm:block"
      >
      </div>
      <div
        class="absolute bottom-12 left-[42%] hidden h-24 w-24 rotate-12 rounded-[1.75rem] border border-ink-200/80 bg-white/45 sm:block"
      >
      </div>
      <div
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-400/70 to-transparent"
      >
      </div>
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div class="space-y-7">
          <p class="eyebrow">Dublin City University research group</p>
          <div class="space-y-5">
            <h1
              class="max-w-4xl text-[clamp(2.5rem,8vw,5.2rem)] leading-[0.95] text-ink-900"
            >
              {title}
            </h1>
            <p class="max-w-2xl text-lg leading-8 text-ink-600">{mission}</p>
          </div>
          <p class="max-w-2xl text-base leading-8 text-ink-500">
            {description}
          </p>
          <div class="flex flex-col gap-4 sm:flex-row">
            <a
              class="inline-flex items-center justify-center rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-accent-600"
              href={primaryHref}
            >
              {primaryLabel}
            </a>
            <a
              class="inline-flex items-center justify-center rounded-full border border-ink-200 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:-translate-y-0.5 hover:border-accent-400 hover:text-accent-600"
              href={secondaryHref}
            >
              {secondaryLabel}
            </a>
          </div>
        </div>

        <div class="relative">
          <div
            class="overflow-hidden rounded-[2rem] border border-white/70 bg-ink-900 shadow-[0_30px_80px_rgba(10,21,36,0.2)]"
          >
            <img
              src={imageSrc}
              alt={imageAlt}
              class="hero-image h-[320px] w-full object-cover sm:h-[420px]"
            />
          </div>
          <div
            class="card-surface absolute inset-x-4 bottom-4 max-w-sm p-4 sm:inset-x-auto sm:-bottom-6 sm:left-8 sm:max-w-xs sm:p-5"
          >
            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-400"
            >
              Partner-led impact
            </p>
            <p class="mt-3 text-sm leading-7 text-ink-600">
              Research developed across DCU, shaped with collaborators, and
              designed to read as both rigorous and publicly legible.
            </p>
          </div>
          <div
            class="absolute left-4 top-4 right-auto rounded-full border border-white/30 bg-white/90 px-3 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-ink-700 sm:left-auto sm:right-6 sm:top-6 sm:px-4 sm:text-xs sm:tracking-[0.2em]"
          >
            Dublin City University
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
