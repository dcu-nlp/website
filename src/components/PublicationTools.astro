---
import type { NormalizedPublication } from '@/utils/publications';
interface Props {
  publication: NormalizedPublication;
}
const { publication: p } = Astro.props;
const escape = (text: string) =>
  text.replace(/[\\{}%&#_$]/g, (char) => `\\${char}`);
const bibtex =
  p.bibtex ||
  `@misc{${p.slug},\n  title = {${escape(p.title)}},\n  author = {${p.authors.map(escape).join(' and ')}},\n  year = {${p.year}},\n  howpublished = {${escape(p.venue)}}${p.paperUrl ? `,\n  url = {${p.paperUrl}}` : ''}\n}`;
---

<div class="mt-5">
  <div class="flex flex-wrap gap-4 text-sm font-semibold">
    {
      p.pdfUrl && (
        <a class="text-link" href={p.pdfUrl}>
          PDF <span class="sr-only">for {p.title}</span>
        </a>
      )
    }
    {
      p.dataUrl && (
        <a class="text-link" href={p.dataUrl}>
          Dataset <span class="sr-only">for {p.title}</span>
        </a>
      )
    }
  </div>
  <details class="mt-3 text-sm">
    <summary class="text-link cursor-pointer"
      >BibTeX <span class="sr-only">for {p.title}</span></summary
    >
    <pre
      class="mt-3 overflow-x-auto rounded-xl bg-ink-50 p-4 text-ink-900"><code>{bibtex}</code></pre>
  </details>
    <button
      hidden
      type="button"
      class="button-secondary mt-3"
      data-copy-bibtex={bibtex}
      aria-label={`Copy BibTeX for ${p.title}`}>Copy BibTeX</button
    >
    <span class="ml-3 text-sm" role="status" aria-live="polite"></span>
</div>
<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-bibtex]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const status = button.nextElementSibling;
        try {
          await navigator.clipboard.writeText(button.dataset.copyBibtex!);
          if (status) status.textContent = 'BibTeX copied.';
        } catch {
          if (status)
            status.textContent =
              'Copy unavailable. Expand BibTeX above to select and copy it.';
        }
      });
    });
</script>
