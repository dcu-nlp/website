---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  invert?: boolean;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  invert = false,
} = Astro.props;
---

<div
  class:list={[
    'mb-10 space-y-4',
    align === 'center' ? 'text-center' : 'text-left',
  ]}
>
  {
    eyebrow && (
      <p class:list={[invert ? 'section-kicker' : 'eyebrow']}>{eyebrow}</p>
    )
  }
  <h2
    class:list={[
      'text-3xl sm:text-4xl',
      invert ? 'text-white' : 'text-ink-900',
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p
        class:list={[
          'max-w-3xl text-base leading-8',
          invert ? 'text-ink-200' : 'text-ink-600',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
