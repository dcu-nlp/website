---
import type { CollectionEntry } from 'astro:content';
import { getEntrySlug } from '@/utils/content';
import { getSiteHref } from '@/utils/urls';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const slug = getEntrySlug(project);
---

<article class="card-surface h-full p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-400">
    {data.status}
  </p>
  <h3 class="mt-4 text-2xl text-ink-900">
    <a class="hover:text-accent-600" href={getSiteHref(`/projects/${slug}/`)}>
      {data.title}
    </a>
  </h3>
  <p class="mt-4 text-sm leading-7 text-ink-600">{data.summary}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {
      data.tags.map((tag) => (
        <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
          {tag}
        </span>
      ))
    }
  </div>
</article>
