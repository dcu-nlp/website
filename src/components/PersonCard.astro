---
import ExternalLink from '@/components/ExternalLink.astro';
import type { CollectionEntry } from 'astro:content';
import { getEntrySlug } from '@/utils/content';
import { getAssetHref, getMailtoHref, getSiteHref } from '@/utils/urls';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { data } = person;
const slug = getEntrySlug(person);
const tileId = `person-tile-${slug}`;
---

<article id={tileId} class="flip-tile h-full">
  <div class="flip-tile__inner h-full">
    <div
      class="flip-tile__face card-surface flex h-full flex-col overflow-hidden p-6"
    >
      <div class="flex items-start justify-between gap-4">
        <p
          class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-600"
        >
          {data.status}
        </p>
        <button
          type="button"
          class="flip-toggle"
          data-flip-trigger
          data-flip-target={tileId}
          aria-label="Show back of card"
          aria-pressed="false"
        >
          Details
        </button>
      </div>
      {
        data.photo ? (
          <img
            src={getAssetHref(data.photo)}
            alt={`Portrait placeholder for ${data.name}`}
            class="mt-5 h-56 w-full rounded-[1.5rem] object-cover"
          />
        ) : (
          <div class="mt-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-ink-900 text-lg font-semibold text-white">
            {data.name
              .split(' ')
              .map((part) => part[0])
              .slice(0, 2)
              .join('')}
          </div>
        )
      }
      <h3 class="mt-5 text-2xl text-ink-900">
        <a class="hover:text-accent-600" href={getSiteHref(`/people/${slug}/`)}>
          {data.name}
        </a>
      </h3>
      <p class="mt-2 text-sm font-semibold text-accent-600">{data.role}</p>
      <p class="mt-2 text-sm leading-7 text-ink-600">{data.bio}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          data.researchAreas
            .slice(0, 3)
            .map((area) => (
              <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
                {area}
              </span>
            ))
        }
      </div>
    </div>

    <div
      class="flip-tile__face flip-tile__face--back card-surface flex h-full flex-col justify-between p-6"
    >
      <div>
        <div class="flex items-start justify-between gap-4">
          <p
            class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-600"
          >
            Profile
          </p>
          <button
            type="button"
            class="flip-toggle"
            data-flip-trigger
            data-flip-target={tileId}
            aria-label="Show front of card"
            aria-pressed="false"
          >
            Front
          </button>
        </div>
        <h3 class="mt-5 text-2xl text-ink-900">{data.name}</h3>
        <p class="mt-2 text-sm text-ink-500">{data.affiliation}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            data.researchAreas.map((area) => (
              <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
                {area}
              </span>
            ))
          }
        </div>
        <div class="mt-6 space-y-2 text-sm text-ink-600">
          {
            data.website && (
              <p>
                <ExternalLink class="text-link" href={data.website}>
                  Website
                </ExternalLink>
              </p>
            )
          }
          {
            data.scholar && (
              <p>
                <ExternalLink class="text-link" href={data.scholar}>
                  Scholar
                </ExternalLink>
              </p>
            )
          }
          {
            data.linkedin && (
              <p>
                <ExternalLink class="text-link" href={data.linkedin}>
                  LinkedIn
                </ExternalLink>
              </p>
            )
          }
          {
            data.email && (
              <p>
                <a class="text-link" href={getMailtoHref(data.email)}>
                  {data.email}
                </a>
              </p>
            )
          }
        </div>
      </div>
      <a
        class="mt-6 inline-flex text-link"
        href={getSiteHref(`/people/${slug}/`)}
      >
        View full profile
      </a>
    </div>
  </div>
</article>
