---
import ExternalLink from '@/components/ExternalLink.astro';
import {
  sanitizePublicationDisplayText,
  type NormalizedPublication,
} from '@/utils/publications';
import { getSiteHref } from '@/utils/urls';

interface Props {
  publication: NormalizedPublication;
}

const { publication } = Astro.props;
const tileId = `publication-tile-${publication.slug}`;
const displayTitle = sanitizePublicationDisplayText(publication.title);
const displayAbstract = sanitizePublicationDisplayText(
  publication.abstract ||
    'Read the full record for authors, venue, and publication details.',
);
---

<article id={tileId} class="flip-tile h-full">
  <div class="flip-tile__inner h-full">
    <div class="flip-tile__face card-surface flex h-full flex-col p-6">
      <div class="flex items-start justify-between gap-4">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-600"
        >
          {publication.year}
        </p>
        <button
          type="button"
          class="flip-toggle"
          data-flip-trigger
          data-flip-target={tileId}
          aria-label="Show back of card"
          aria-pressed="false"
        >
          Details
        </button>
      </div>
      <h3 class="mt-4 text-2xl text-ink-900">
        <a
          class="hover:text-accent-600"
          href={getSiteHref(`/publications/${publication.slug}/`)}
        >
          {displayTitle}
        </a>
      </h3>
      <p class="mt-3 text-sm leading-7 text-ink-600">{displayAbstract}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          publication.tags
            .slice(0, 3)
            .map((tag) => (
              <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
                {tag}
              </span>
            ))
        }
      </div>
      <div class="mt-auto pt-6 text-sm font-medium text-ink-500">
        {publication.venue}
      </div>
    </div>

    <div
      class="flip-tile__face flip-tile__face--back card-surface flex h-full flex-col justify-between p-6"
    >
      <div>
        <div class="flex items-start justify-between gap-4">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-600"
          >
            {publication.venue}
          </p>
          <button
            type="button"
            class="flip-toggle"
            data-flip-trigger
            data-flip-target={tileId}
            aria-label="Show front of card"
            aria-pressed="false"
          >
            Front
          </button>
        </div>
        <h3 class="mt-4 text-2xl text-ink-900">{displayTitle}</h3>
        <p class="mt-3 text-sm leading-7 text-ink-600">
          {publication.authors.join(', ')}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span
            class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600"
            >{publication.year}</span
          >
          {
            publication.award && (
              <span class="rounded-full bg-accent-400/10 px-3 py-1 text-xs font-medium text-accent-600">
                {publication.award}
              </span>
            )
          }
          {
            publication.tags.map((tag) => (
              <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-medium text-ink-600">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm font-semibold">
        <a
          class="text-link"
          href={getSiteHref(`/publications/${publication.slug}/`)}
        >
          View details
        </a>
        {
          publication.paperUrl && (
            <ExternalLink class="text-link" href={publication.paperUrl}>
              Paper
            </ExternalLink>
          )
        }
      </div>
    </div>
  </div>
</article>
