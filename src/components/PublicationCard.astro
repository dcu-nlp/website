---
import ExternalLink from '@/components/ExternalLink.astro';
import type { NormalizedPublication } from '@/utils/publications';
import { getSiteHref } from '@/utils/urls';

interface Props {
  publication: NormalizedPublication;
  headingLevel?: 'h2' | 'h3';
}
const { publication, headingLevel: Heading = 'h3' } = Astro.props;
const citation = `${publication.authors.join(', ')}. ${publication.year}. ${publication.title}. ${publication.venue}.${publication.paperUrl ? ` ${publication.paperUrl}` : ''}`;
---

<article
  class="publication-card card-surface flex h-full min-w-0 flex-col p-6 sm:p-8"
>
  <p class="text-sm font-semibold text-accent-600">
    <span>{publication.year}</span><span aria-hidden="true"> · </span>{
      publication.venue
    }
  </p>
  <Heading class="mt-3 text-2xl text-ink-900">
    <a
      class="hover:text-accent-600"
      href={getSiteHref(`/publications/${publication.slug}/`)}
      >{publication.title}</a
    >
  </Heading>
  <p class="mt-3 text-sm leading-7 text-ink-600">
    {publication.authors.join(', ')}
  </p>
  {
    publication.abstract && (
      <p class="publication-abstract mt-4 text-sm leading-7 text-ink-600">
        {publication.abstract}
      </p>
    )
  }
  {
    publication.tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Research topics">
        {publication.tags.map((tag) => (
          <li class="rounded-full bg-ink-50 px-3 py-1 text-xs font-medium text-ink-600">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
  <div
    class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-6 text-sm font-semibold"
  >
    {
      publication.paperUrl && (
        <ExternalLink class="text-link" href={publication.paperUrl}>
          Paper <span class="sr-only">for {publication.title}</span>
        </ExternalLink>
      )
    }
    {
      publication.codeUrl && (
        <ExternalLink class="text-link" href={publication.codeUrl}>
          Code <span class="sr-only">for {publication.title}</span>
        </ExternalLink>
      )
    }
    <a
      class="text-link"
      href={getSiteHref(`/publications/${publication.slug}/`)}
      >Details <span class="sr-only">for {publication.title}</span></a
    >
  </div>
  <details class="mt-4 text-sm text-ink-600">
    <summary class="w-fit cursor-pointer font-semibold text-accent-600"
      >Cite <span class="sr-only">{publication.title}</span></summary
    >
    <p class="mt-3 break-words rounded-xl bg-ink-50 p-4 leading-7 select-all">
      {citation}
    </p>
  </details>
</article>
