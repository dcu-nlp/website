---
import ExternalLink from '@/components/ExternalLink.astro';
import { siteConfig } from '@/utils/site';
import { getAssetHref } from '@/utils/urls';
---

<section class="section-space pt-0">
  <div class="container-shell">
    <div
      class="logo-strip-panel relative overflow-hidden rounded-[2rem] px-5 py-8 sm:px-8 lg:px-10"
    >
      <div
        class="absolute -right-8 top-3 hidden h-24 w-24 rounded-full border border-accent-500/12 bg-white/35 sm:block"
      >
      </div>
      <div class="max-w-2xl">
        <p class="logo-strip-kicker">Partners and collaborators</p>
        <h2
          class="mt-3 text-[clamp(2rem,7vw,2.6rem)] leading-[1.04] text-ink-900"
        >
          Research, education, and applied collaboration partners
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-ink-600">
          A selected set of organisations connected to the group’s research,
          teaching, and public-facing project work.
        </p>
      </div>
      <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          siteConfig.partnerLogos.map((partner) => (
            <ExternalLink
              class="logo-badge group"
              href={partner.href}
              aria-label={partner.label}
              title={partner.label}
            >
              <span class="sr-only">{partner.label}</span>
              <img
                src={getAssetHref(partner.image)}
                alt={partner.imageAlt}
                class:list={[
                  'logo-mark h-auto w-auto max-w-[11.5rem] object-contain sm:max-w-[15rem]',
                  partner.logoClass ?? 'max-h-10',
                  partner.logoImageClass,
                ]}
                loading="lazy"
              />
            </ExternalLink>
          ))
        }
      </div>
    </div>
  </div>
</section>
